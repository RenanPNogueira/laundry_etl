# =========================================================
# .env.example — ETL da Lavanderia
# =========================================================
# Copie este arquivo para ".env" (na raiz do projeto) e preencha com
# valores reais. NUNCA preencha valores reais aqui neste .env.example —
# ele é versionado no Git. O arquivo ".env" real já está no .gitignore.
#
# Se uma variável não existir no .env, o código ainda tenta ler do
# ambiente do Windows. Se não existir em nenhum dos dois, o orquestrador
# falha no início com uma mensagem indicando exatamente qual variável
# está faltando.
# =========================================================

# --------- Caminho base do projeto (obrigatório) ---------
SUPPORT_DEFAULT_PATH=

# --------- PostgreSQL (obrigatório) ---------
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_LSXP_DATABASE=

# --------- Sistema de lavanderia (obrigatório) ---------
LAUNDRY_SYSTEM_API_KEY=
LAUNDRY_SYSTEM_BUSINESS_ID=

# --------- Sistema de lavanderia — endpoint da API (opcional, já tem default no código) ---------
LAUNDRY_SYSTEM_BASE_URL=

# --------- Banco 1 / Banco 2 — credenciais compartilhadas (obrigatório) ---------
USER_ID=
BANK1_PASSWORD=
BANK2_PASSWORD=
DOWNLOAD_PATH=

# --------- Banco 1 — endpoint de login (opcional, já tem default no código) ---------
BANK1_LOGIN_URL=

# --------- Banco 2 — recebimento por e-mail via IMAP (obrigatório) ---------
BANK2_IMAP_SERVER=
BANK2_IMAP_PORT=
BUSINESS_MAIL=
BUSINESS_MAIL_PSWD=

# --------- Banco 2 — valores com default já assumido no código (opcional) ---------
BANK2_EMAIL_SENDER=
BANK2_EMAIL_SUBJECT=
BANK2_REPORT_DESTINATION_EMAIL=
BANK2_LOGIN_URL=

# --------- Pastas locais (opcional — sem elas, usa os defaults do settings.py) ---------
BANK1_FATURAS_FOLDER=
BANK3_ARQUIVOS_FOLDER=
TEMP_FOLDER=

# --------- Pasta temporária de downloads (opcional) ---------
TEMP_DOWNLOAD_FOLDER=
